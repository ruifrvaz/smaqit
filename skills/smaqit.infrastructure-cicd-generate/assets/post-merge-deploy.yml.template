name: Trigger Deploy After Merge

on:
  pull_request:
    types: [closed]

permissions:
  actions: write

jobs:
  trigger-deploy:
    # PR body sentinel, not a label — Copilot Coding Agent tokens lack issues:write and
    # cannot apply labels. Must be set in the PR body at creation time.
    if: github.event.pull_request.merged == true && contains(github.event.pull_request.body, 'smaqit:deploy')
    runs-on: ubuntu-latest
    steps:
      # This job has no checkout, so gh cannot infer the repository from a git remote: name it
      # with --repo. Event values reach the script through env:, never interpolated into it.
      - name: Dispatch deploy.yml
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          BASE_REF: ${{ github.event.pull_request.base.ref }}
        run: gh workflow run deploy.yml --repo "$GH_REPO" --ref "$BASE_REF"
