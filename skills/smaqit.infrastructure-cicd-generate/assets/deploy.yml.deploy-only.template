name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

# provisioning_mode: existing-shared — this project deploys onto a VM a different
# project owns and provisions. No provision job, no Terraform step of any kind.
jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      VM_HOST: ${{ vars.VM_HOST }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Install backend dependencies
        working-directory: backend
        run: npm ci

      - name: Build backend
        working-directory: backend
        run: npm run build

      - name: Install frontend dependencies
        working-directory: frontend
        run: npm ci

      # VITE_* vars are build-time only — Vite bakes them in at compile time, they are
      # not available at runtime. Never move this to a later (deploy) step.
      - name: Build frontend
        working-directory: frontend
        env:
          VITE_DEMO_MODE: ${{ vars.VITE_DEMO_MODE }}
        run: npm run build

      - name: Set up SSH key
        run: |
          install -m 700 -d ~/.ssh
          printf '%s' "${{ secrets.VM_SSH_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -H "$VM_HOST" >> ~/.ssh/known_hosts

      # CRITICAL: mkdir -p the full dist path before rsyncing. The trailing slash on
      # backend/dist/ copies the directory's *contents* — if the target directory does
      # not exist, rsync creates it one level too shallow and the container fails with
      # "Cannot find module '/app/dist/index.js'".
      - name: Ensure remote backend dist directory exists
        run: ssh -i ~/.ssh/deploy_key "ubuntu@$VM_HOST" "mkdir -p __APP_DIR__/backend/dist"

      - name: Rsync backend artifacts
        run: |
          rsync -avz --delete -e "ssh -i ~/.ssh/deploy_key" backend/dist/ "ubuntu@$VM_HOST:__APP_DIR__/backend/dist/"
          rsync -avz -e "ssh -i ~/.ssh/deploy_key" backend/package.json backend/package-lock.json "ubuntu@$VM_HOST:__APP_DIR__/backend/"

      - name: Install node_modules on VM
        run: ssh -i ~/.ssh/deploy_key "ubuntu@$VM_HOST" "cd __APP_DIR__/backend && docker run --rm -v \$(pwd):/app -w /app node:22-alpine npm install --production"

      - name: Rsync frontend build
        run: rsync -avz --delete -e "ssh -i ~/.ssh/deploy_key" frontend/dist/ "ubuntu@$VM_HOST:__APP_DIR__/frontend/"

      # Write to __APP_DIR__/backend/, not __APP_DIR__/ — the container mounts
      # __APP_DIR__/backend/ as /app; files one level up are invisible to it.
      # printf '%s', not echo — echo appends a newline that readFileSync would include.
      - name: Write deploy stamps
        run: |
          ssh -i ~/.ssh/deploy_key "ubuntu@$VM_HOST" "printf '%s' '${{ github.sha }}' > __APP_DIR__/backend/DEPLOY_SHA && printf '%s' \"\$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > __APP_DIR__/backend/DEPLOY_TIME"

      # docker compose (v2, no hyphen). --force-recreate is required even when no image
      # changed — the app is deployed as files, not as a new image.
      - name: Restart containers
        run: ssh -i ~/.ssh/deploy_key "ubuntu@$VM_HOST" "cd __APP_DIR__ && docker compose up -d --force-recreate"

      # reload-or-restart, not a bare reload — this VM is co-hosted, and this site is
      # never the one that starts nginx for the first time (see write-vhost.sh /
      # smaqit.infrastructure-deploy-rsync's default_server-vs-name-based vhost rule).
      - name: Reload nginx
        run: ssh -i ~/.ssh/deploy_key "ubuntu@$VM_HOST" "sudo nginx -t && sudo systemctl reload-or-restart nginx"
