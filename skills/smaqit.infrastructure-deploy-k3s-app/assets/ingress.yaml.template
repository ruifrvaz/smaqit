# Shared Ingress template for smaqit.infrastructure-deploy-k3s-app, Ingress Mode own-tls.
#
# Rendered per app by substituting __APP_SLUG__ — never hand-write a per-app Ingress — and
# committed as deployment/k3s/ingress.yaml. The app's Ingress requests its own certificate from the
# environment's cert-manager ClusterIssuer (ingress-shim names the Certificate after secretName).
# Use ingress-default-tls.yaml.template for platform-default-tls; ship no Ingress for
# platform-owned.
#
# The per-environment tokens stay in the committed file and are stamped at apply time from the
# Infrastructure spec's Environments row (CI: the dispatched machine's K3S_TARGETS entry), never
# guessed or hardcoded:
#   __APP_SLUG__       — the app slug; the Namespace is always app-__APP_SLUG__
#   __INGRESS_CLASS__  — the environment's Ingress Class
#   __CLUSTER_ISSUER__ — the environment's ClusterIssuer
#   __HOST__           — the environment's Host

apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: __APP_SLUG__
  namespace: app-__APP_SLUG__
  annotations:
    cert-manager.io/cluster-issuer: __CLUSTER_ISSUER__
spec:
  ingressClassName: __INGRESS_CLASS__
  tls:
    - hosts:
        - __HOST__
      secretName: __APP_SLUG__-tls
  rules:
    - host: __HOST__
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: __APP_SLUG__
                port:
                  number: 80
