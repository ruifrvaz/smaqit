# Reference Deployment template for smaqit.infrastructure-deploy-k3s-app.
#
# Shows a Pod Security "restricted"-compliant Pod template with the deploy-stamp environment
# variables (DEPLOY_SHA, DEPLOY_TIME) set at apply time — the k3s family's equivalent of the
# rsync family's DEPLOY_SHA/DEPLOY_TIME stamp files, since this credential has no host
# filesystem to write to. Adapt container name, image, port, and resource sizing to the app;
# do not remove or weaken any of the securityContext fields below — manifest-lint.sh rejects a
# manifest missing any of them before any kubectl apply runs.
#
# NOT shown below: runAsUser. It is deliberately not a token here — its correct value is the
# base image's own real numeric UID, which varies per image and is not this template's to guess.
# manifest-lint.sh requires an explicit numeric runAsUser (pod- or container-level) wherever
# runAsNonRoot is true; add it explicitly when authoring the concrete manifest (see
# smaqit.infrastructure-image-build-push-static for the static-site case, or confirm the base
# image's UID directly with `docker run --rm <image> id`). Omitting it here is not a template gap
# to fix — it is the one field every app-specific manifest-authoring step must still add itself.
#
# Tokens:
#   __APP_SLUG__   — the app slug; the Namespace is always app-__APP_SLUG__
#   __IMAGE__      — the app's container image reference
#   __DEPLOY_SHA__ — the commit SHA being deployed, set by the caller at apply time
#   __DEPLOY_TIME__ — an ISO 8601 UTC timestamp, set by the caller at apply time
#   __REPLICAS__   — replica count; defaults to 1. Two replicas at the default request size alone
#                    consumes a full per-app ResourceQuota ceiling on some onboarded clusters, and
#                    leaves no headroom for a RollingUpdate surge pod or cert-manager's HTTP-01
#                    solver pod (both schedule inside this Namespace). Raise only against a
#                    confirmed quota ceiling.
#   __CPU_REQUEST__ — per-container CPU request; defaults to 50m (conservative, proven-live)
#   __MEM_REQUEST__ — per-container memory request; defaults to 32Mi (conservative, proven-live)

apiVersion: apps/v1
kind: Deployment
metadata:
  name: __APP_SLUG__
  namespace: app-__APP_SLUG__
  labels:
    app: __APP_SLUG__
spec:
  replicas: __REPLICAS__
  selector:
    matchLabels:
      app: __APP_SLUG__
  template:
    metadata:
      labels:
        app: __APP_SLUG__
    spec:
      # imagePullSecrets: only present when the spec names a private registry — see
      # smaqit.infrastructure-deploy-k3s-app/SKILL.md Step 4.
      # imagePullSecrets:
      #   - name: app-registry
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: __APP_SLUG__
          image: __IMAGE__
          ports:
            - containerPort: 8080
          env:
            - name: DEPLOY_SHA
              value: "__DEPLOY_SHA__"
            - name: DEPLOY_TIME
              value: "__DEPLOY_TIME__"
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests:
              cpu: "__CPU_REQUEST__"
              memory: "__MEM_REQUEST__"
            limits:
              cpu: "500m"
              memory: "256Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: __APP_SLUG__
  namespace: app-__APP_SLUG__
spec:
  selector:
    app: __APP_SLUG__
  ports:
    - port: 80
      targetPort: 8080
